# API listen address. Defaults to :9090 when unset.
AGENT_HARBOR_ADDR=:9090

# Optional management API key. Management and audit endpoints require either this key,
# AGENT_HARBOR_ADMIN_IDENTITIES, or the explicit development-only unauthenticated flag below.
AGENT_HARBOR_ADMIN_KEY=

# Optional named admin identities for production approval flows.
# Use actor=key entries separated by comma or semicolon. Example: requester=req-key;security=sec-key
AGENT_HARBOR_ADMIN_IDENTITIES=

# Development-only. Allows management endpoints without X-Admin-Key when no admin key or identities are configured.
AGENT_HARBOR_ALLOW_UNAUTHENTICATED_ADMIN=false

# Development-only. Allows loopback/private upstream endpoints for local scenarios.
AGENT_HARBOR_ALLOW_PRIVATE_UPSTREAMS=false

# Optional approval reviewer routing rules. Use reviewer=tenantId/workspaceId entries separated by comma or semicolon.
# Example: security-root=tenant-root/*;security-east=tenant-east/ws-support
AGENT_HARBOR_APPROVAL_REVIEWERS=

# Optional extra browser origins for local console or isolated browser gates.
# Example: http://127.0.0.1:15174
AGENT_HARBOR_CORS_ORIGINS=

# Optional PostgreSQL runtime connection. Leave empty to use the in-memory repository.
AGENT_HARBOR_DATABASE_URL=

# Required only when AGENT_HARBOR_DATABASE_URL is set. Use a 32-byte raw or base64 key.
AGENT_HARBOR_CREDENTIAL_KEY=

# Optional PostgreSQL integration-test connection.
AGENT_HARBOR_TEST_DATABASE_URL=

# Frontend API base URL.
VITE_API_BASE=http://127.0.0.1:9090
