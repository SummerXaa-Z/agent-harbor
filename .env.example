# API listen address. Defaults to :9090 when unset.
AGENT_HARBOR_ADDR=:9090

# Optional deployment mode. Set to production for deployment-style preflight checks.
AGENT_HARBOR_DEPLOYMENT_MODE=development

# Optional management API key. Management and audit endpoints require either this key,
# AGENT_HARBOR_ADMIN_IDENTITIES, or the explicit development-only unauthenticated flag below.
# Production mode requires at least 16 characters and rejects common weak values.
AGENT_HARBOR_ADMIN_KEY=

# Optional named admin identities for production approval flows and scoped administration.
# Use actor=key entries separated by comma or semicolon.
# Actor names must use 1-80 letters, numbers, dots, underscores, hyphens, or at signs.
# Production mode validates actor/key syntax, role names, scoped tenant requirements,
# duplicate actors/keys, reserved actor names (admin-key/local-dev), and the same
# admin-key strength rule for every named identity key.
# Production mode also requires AGENT_HARBOR_ADMIN_KEY or at least one role=platform_admin identity
# so recovery administration remains possible. role=platform_admin entries must not include tenant/workspace.
# Example: requester=requester-admin-key-32;security=security-admin-key-32|role=security_reviewer|tenant=tenant-root
AGENT_HARBOR_ADMIN_IDENTITIES=

# Optional in development. Required in production for web-console HttpOnly session signing.
# Use a stable high-entropy value with at least 32 characters; production mode rejects
# missing, short, or common weak values.
AGENT_HARBOR_SESSION_SECRET=

# Development-only. Allows management endpoints without X-Admin-Key when no admin key or identities are configured.
AGENT_HARBOR_ALLOW_UNAUTHENTICATED_ADMIN=false

# Development-only. Allows loopback/private upstream endpoints for local scenarios.
AGENT_HARBOR_ALLOW_PRIVATE_UPSTREAMS=false

# Optional approval reviewer routing rules. Use reviewer=tenantId/workspaceId entries separated by comma or semicolon.
# Production preflight validates this format before storage initialization when configured.
# In production, each reviewer must match admin-key or an AGENT_HARBOR_ADMIN_IDENTITIES actor
# with role=security_reviewer or role=platform_admin, and the route must stay within that
# reviewer's tenant/workspace scope unless the reviewer is a platform admin.
# Example: security-root=tenant-root/*;security-east=tenant-east/ws-support
AGENT_HARBOR_APPROVAL_REVIEWERS=

# Optional extra browser origins for local console or isolated browser gates.
# Use full http(s) origins only: scheme + host + optional port, no wildcard/path/query.
# Example: http://127.0.0.1:15174
AGENT_HARBOR_CORS_ORIGINS=

# Optional in development. Required in production so tenant, grant, credential,
# and audit state survive restart. Production preflight validates the string
# before PostgreSQL initialization and does not echo credentials in errors.
AGENT_HARBOR_DATABASE_URL=

# Required when AGENT_HARBOR_DATABASE_URL is set. Production preflight validates
# it before PostgreSQL initialization. Use 32 random bytes or base64, for example:
# openssl rand -base64 32.
AGENT_HARBOR_CREDENTIAL_KEY=

# Optional PostgreSQL integration-test connection.
AGENT_HARBOR_TEST_DATABASE_URL=

# Frontend API base URL.
VITE_API_BASE=http://127.0.0.1:9090
